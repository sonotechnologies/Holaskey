# Public site URL (used for Paystack callbacks, emails, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys. (Legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="HOLASKEY <orders@holaskey.com>"
OWNER_EMAIL=

# Protects /api/cron/daily (Vercel sends it as a Bearer token)
CRON_SECRET=
