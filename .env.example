# Public site URL (used for Paystack callbacks, emails, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys. (Legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Email — set SMTP (e.g. Gmail with an app password) OR Resend.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-letter app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Sender shown to customers (defaults to SMTP_USER). With Gmail it must be your Gmail address.
EMAIL_FROM="HOLASKEY <you@gmail.com>"
# Gets new-order and new-custom-request alerts
OWNER_EMAIL=

# Protects /api/cron/daily (Vercel sends it as a Bearer token)
CRON_SECRET=
